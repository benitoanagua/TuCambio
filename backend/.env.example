# Local HTTP server configuration
PORT=8080
APP_ENV=local

# Supabase and database credentials will be introduced with the Auth and
# persistence integration milestones. Never commit real credentials here.

# Supabase Auth JWT verification (server-side only)
# Use the project URL, not the JWKS URL. HTTP is accepted only for localhost.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
